{
  "name": "bunnies",
  "author": "Matheus Souza <matheusouzadearaujo@gmail.com> (https://github.com/mxtheussouza)",
  "productName": "Bunnies",
  "version": "1.0.0",
  "description": "Bunnies is a RabbitMQ management GUI.",
  "main": ".webpack/main/index.cjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mts,json,yml,yaml,scss,less,html}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mts,json,yml,yaml,scss,less,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check && npm run docs:check",
    "smoke:package": "node tools/testing/smoke.cjs",
    "docs:generate": "node tools/docs/user-guide.cjs --write",
    "docs:check": "node tools/docs/user-guide.cjs --check"
  },
  "keywords": [
    "rabbit",
    "amqp",
    "rabbitmq"
  ],
  "config": {
    "forge": "./tools/forge/forge.config.js"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-webpack": "8.0.1",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "cross-env": "10.1.0",
    "css-loader": "7.1.5",
    "electron": "45.1.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "jsdom": "30.1.3",
    "less": "4.9.1",
    "less-loader": "13.1.0",
    "mini-css-extract-plugin": "2.10.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "sass-loader": "17.1.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webpack": "5.112.2"
  },
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "electron-winstaller": false,
    "@parcel/watcher": false,
    "fsevents": false
  }
}
