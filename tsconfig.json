{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@assets/*": ["./assets/*"],
      "@misc/*": ["./misc/*"],
      "@src/*": ["./src/*"],
      "@tools/*": ["./tools/*"]
    }
  },
  "include": ["src/**/*", "misc/**/*", "vitest.config.mts"]
}
